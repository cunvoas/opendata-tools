  "version": "2.0.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.js",
    "build:raspberry": "vite build --mode raspberry",
    "build:github": "vite build --mode github",
    "preview": "vite preview",
    "sonar": "sonar-scanner",
    "sonar:local": "sonar-scanner -Dsonar.host.url=http://192.168.8.21:9000",
    "sonar:token": "sonar-scanner -Dsonar.token=$SONAR_TOKEN",
    "sonar:full": "npm run test:coverage && sonar-scanner -Dsonar.host.url=http://192.168.8.21:9000 -Dsonar.token=$SONAR_TOKEN",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.4",
    "node-forge": "^1.4.3",
    "decode-uri-component": "^0.5.1",
    "braces": "^3.0.3",
    "http-proxy-middleware": "^2.0.10"
  },
  "dependencies": {
    "@certible/use-matomo": "^1.3.0",
    "axios": "^1.21.1",
    "chartjs": "^0.3.24",
    "leaflet-fullscreen": "^1.0.2",
    "lodash": "^4.18.1",
    "video.js": "^10.4.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.33",
    "sass-embedded": "^1.108.2",
    "sonarqube-scanner": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
